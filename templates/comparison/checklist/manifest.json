{
  "id": "checklist",
  "family": "comparison",
  "description": "Feature checklist comparison: ticks appear row-by-row with an accent label/value header.",
  "keywords": [
    "compare",
    "checklist",
    "features",
    "matrix",
    "criteria",
    "ticks",
    "adoption"
  ],
  "supportedContentKeys": {
    "title": {
      "maxChars": 70
    },
    "label": {
      "maxChars": 24
    },
    "value": {
      "maxChars": 24
    },
    "items": {
      "maxItems": 6
    },
    "caption": {
      "maxChars": 120
    }
  },
  "variations": [
    {
      "id": "default",
      "structure": "structure1.jsx",
      "animation": "stagger-fade-in",
      "style": {
        "palette": {
          "background": "#0b0b12",
          "foreground": "#f5f5f7",
          "accent": "#34d399"
        },
        "font": {
          "heading": "Inter",
          "body": "Inter",
          "scale": 1
        }
      }
    }
  ]
}