{
  "id": "collage",
  "family": "gallery",
  "description": "Irregular collage grid of up to 4 images anchored at the corners. Good for highlight reel.",
  "keywords": [
    "gallery",
    "collage",
    "mosaic",
    "feature",
    "highlight",
    "images"
  ],
  "supportedContentKeys": {
    "title": {
      "maxChars": 70
    },
    "images": {
      "required": true,
      "maxItems": 4
    },
    "caption": {
      "maxChars": 120
    }
  },
  "variations": [
    {
      "id": "default",
      "structure": "structure1.jsx",
      "animation": "stagger-fade-in",
      "style": {
        "palette": {
          "background": "#0b0b12",
          "foreground": "#f5f5f7"
        },
        "font": {
          "heading": "Inter",
          "body": "Inter",
          "scale": 1
        }
      }
    }
  ]
}