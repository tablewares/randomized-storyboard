{
  "id": "banner-strip",
  "family": "hero",
  "description": "Banner hero with title anchored to the bottom of the frame, like a lower-third on a cover frame.",
  "keywords": [
    "hero",
    "banner",
    "lower-third",
    "bottom",
    "title",
    "full-bleed",
    "opener"
  ],
  "supportedContentKeys": {
    "title": {
      "required": true,
      "maxChars": 90
    },
    "subtitle": {
      "maxChars": 100
    },
    "label": {
      "maxChars": 24
    }
  },
  "variations": [
    {
      "id": "default",
      "structure": "structure1.jsx",
      "animation": "fade-up",
      "style": {
        "palette": {
          "background": "#0b0b12",
          "foreground": "#f5f5f7",
          "accent": "#7c5cff"
        },
        "font": {
          "heading": "Inter",
          "body": "Inter",
          "scale": 1
        }
      }
    }
  ]
}