{
  "id": "quote-hero",
  "family": "hero",
  "description": "Hero variant that leads with a big quote and puts the section title underneath as attribution context.",
  "keywords": [
    "hero",
    "quote",
    "lead",
    "opener",
    "pull-quote",
    "headline"
  ],
  "supportedContentKeys": {
    "quote": {
      "required": true,
      "maxChars": 260
    },
    "title": {
      "maxChars": 90
    },
    "source": {
      "maxChars": 60
    },
    "caption": {
      "maxChars": 120
    }
  },
  "variations": [
    {
      "id": "default",
      "structure": "structure1.jsx",
      "animation": "fade-in",
      "style": {
        "palette": {
          "background": "#0f0f12",
          "foreground": "#f5f5f7",
          "accent": "#ff6b6b"
        },
        "font": {
          "heading": "Georgia, serif",
          "body": "Inter",
          "scale": 1
        }
      }
    }
  ]
}