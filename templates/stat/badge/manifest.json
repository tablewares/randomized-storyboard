{
  "id": "badge",
  "family": "stat",
  "description": "Compact stat with a small uppercase accent badge label on top of an oversized number. Good for data callouts.",
  "keywords": [
    "stat",
    "metric",
    "badge",
    "kpi",
    "callout",
    "data",
    "tag",
    "label"
  ],
  "supportedContentKeys": {
    "number": {
      "required": true,
      "maxChars": 16
    },
    "label": {
      "maxChars": 24
    },
    "source": {
      "maxChars": 60
    },
    "caption": {
      "maxChars": 120
    }
  },
  "variations": [
    {
      "id": "default",
      "structure": "structure1.jsx",
      "animation": "fade-in",
      "style": {
        "palette": {
          "background": "#0e0e16",
          "foreground": "#f5f5f7",
          "accent": "#38bdf8"
        },
        "font": {
          "heading": "Inter",
          "body": "Inter",
          "scale": 1
        }
      }
    }
  ]
}