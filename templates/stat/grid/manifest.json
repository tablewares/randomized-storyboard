{
  "id": "grid",
  "family": "stat",
  "description": "A 2-column grid of stats. Headline number/label become the top-left card; pairs of items become subsequent cards.",
  "keywords": [
    "stat",
    "grid",
    "panel",
    "dashboard",
    "metrics",
    "matrix",
    "overview",
    "data"
  ],
  "supportedContentKeys": {
    "number": {
      "maxChars": 16
    },
    "label": {
      "maxChars": 40
    },
    "items": {
      "maxItems": 8
    },
    "caption": {
      "maxChars": 100
    }
  },
  "variations": [
    {
      "id": "default",
      "structure": "structure1.jsx",
      "animation": "stagger-fade-in",
      "style": {
        "palette": {
          "background": "#0b0b12",
          "foreground": "#f5f5f7",
          "accent": "#7c5cff",
          "muted": "#2a2a40"
        },
        "font": {
          "heading": "Inter",
          "body": "Inter",
          "scale": 1
        }
      }
    }
  ]
}