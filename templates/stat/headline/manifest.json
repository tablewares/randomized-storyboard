{
  "id": "headline",
  "family": "stat",
  "description": "A single oversized statistic with optional label and caption. Good for KPIs, big percentages, headline figures.",
  "keywords": [
    "stat",
    "number",
    "metric",
    "kpi",
    "figure",
    "headline",
    "data",
    "percentage"
  ],
  "supportedContentKeys": {
    "number": {
      "required": true
    },
    "label": {
      "maxChars": 60
    },
    "caption": {
      "maxChars": 140
    },
    "source": {
      "maxChars": 80
    }
  },
  "variations": [
    {
      "id": "default",
      "structure": "structure1.jsx",
      "animation": "fade-up",
      "style": {
        "palette": {
          "background": "#0b0b12",
          "foreground": "#f5f5f7",
          "accent": "#7c5cff"
        },
        "font": {
          "heading": "Inter",
          "body": "Inter",
          "scale": 1
        }
      }
    },
    {
      "id": "pop",
      "structure": "structure2.jsx",
      "animation": "pop-in",
      "weight": 0.85,
      "style": {
        "palette": {
          "background": "#111417",
          "foreground": "#ffffff",
          "accent": "#ffcc00"
        },
        "font": {
          "heading": "Inter",
          "body": "Inter",
          "scale": 1.1
        }
      }
    },
    {
      "id": "count",
      "structure": "structure3.jsx",
      "animation": "count-up",
      "style": {
        "palette": {
          "background": "#0b1020",
          "foreground": "#eef2ff",
          "accent": "#38bdf8"
        },
        "font": {
          "heading": "Inter",
          "body": "Inter",
          "scale": 1
        }
      }
    }
  ]
}