{
  "id": "vertical-steps",
  "family": "timeline",
  "description": "Vertical dated timeline. Each item may be a plain string or an object with {date, label/title}.",
  "keywords": [
    "timeline",
    "vertical",
    "history",
    "chronology",
    "dated",
    "events",
    "steps"
  ],
  "supportedContentKeys": {
    "title": {
      "maxChars": 70
    },
    "items": {
      "required": true,
      "maxItems": 6
    },
    "caption": {
      "maxChars": 120
    }
  },
  "variations": [
    {
      "id": "default",
      "structure": "structure1.jsx",
      "animation": "stagger-fade-in",
      "style": {
        "palette": {
          "background": "#0b0b12",
          "foreground": "#f5f5f7",
          "accent": "#7c5cff",
          "muted": "#2a2a40"
        },
        "font": {
          "heading": "Inter",
          "body": "Inter",
          "scale": 1
        }
      }
    }
  ]
}