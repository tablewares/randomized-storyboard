","Revisit the list after the timer rings"]},"style":{"palette":{"background":"#0b0f14","foreground":"#eef2f7","accent":"#7c5cff"},"font":{"heading":"Inter, sans-serif","body":"Inter, sans-serif","scale":1.04},"spacing":{"scale":1},"radius":22},"timing":{"id":"principle-4","text":"Step four: log the distraction, don't fight it. Capture it and keep going.","sceneId":"principle-4","startSec":25.299999999999997,"endSec":30.7,"start":25.299999999999997,"end":30.7},"contentWarnings":[]},{"sceneId":"close","family":"lists","templateId":"lists/basic","variationId":"bold-numbered","structurePath":"lists-basic-structure2.jsx","animation":"pop-in","content":{"title":"Run It Tomorrow","description":"Skills are not traits. They're reps.","items":["Clear the surface","Shrink the slot","Anchor one verb","Capture, don't resist"]},"style":{"palette":{"background":"#0b0f14","foreground":"#eef2f7","accent":"#7c5cff"},"font":{"heading":"Inter, sans-serif","body":"Inter, sans-serif","scale":1.04},"spacing":{"scale":1},"radius":22},"timing":{"id":"close","text":"Four moves, one system. Run it tomorrow before you decide you're broken.","sceneId":"close","startSec":30.7,"endSec":35.93,"start":30.7,"end":35.93},"contentWarnings":[]}],"transitions":[{"betweenSceneId":"hook","andSceneId":"principle-1","type":"slide-up"},{"betweenSceneId":"principle-1","andSceneId":"quote-cal","type":"slide-up"},{"betweenSceneId":"quote-cal","andSceneId":"principle-2","type":"fade"},{"betweenSceneId":"principle-2","andSceneId":"principle-3","type":"slide-left"},{"betweenSceneId":"principle-3","andSceneId":"quote-naval","type":"fade"},{"betweenSceneId":"quote-naval","andSceneId":"principle-4","type":"slide-left"},{"betweenSceneId":"principle-4","andSceneId":"close","type":"cut"}]}